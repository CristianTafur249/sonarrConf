# Dockerfile híbrido para MediaJelly
FROM ubuntu:22.04

ARG DEBIAN_FRONTEND=noninteractive

# Configuración completa del sistema
ENV TZ=America/Bogota

RUN apt-get update && apt-get install -y \
    cron \
    curl \
    ffmpeg \
    intel-media-va-driver \
    python3 \
    python3-pip \
    tzdata \
    vainfo \
    git \
    build-essential \
    cmake \
    libsndfile1-dev \
    pkg-config \
    libffi-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/* \
    && ln -snf /usr/share/zoneinfo/"$TZ" /etc/localtime && echo "$TZ" > /etc/timezone \
    && groupadd -g 992 render \
    && useradd -m -s /bin/bash -G video,render mediauser \
    && mkdir -p /mediajelly/scripts/logs /mediajelly/scripts/tmp \
    && chmod 777 /mediajelly/scripts/logs /mediajelly/scripts/tmp \
    && chown -R mediauser:mediauser /mediajelly

# Instalar dependencias de Python
COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir -r /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Copiar scripts y configuraciones
COPY config/crontab.example /etc/cron.d/mediajelly
COPY config/crontab-python /etc/cron.d/mediajelly-python
COPY scripts/*.py /mediajelly/scripts/
COPY scripts/*.sh /mediajelly/scripts/
COPY docker-entrypoint-hybrid.sh /usr/local/bin/

# Compilar whisper.cpp (opcional) para PoC CPU optimized transcription
RUN git clone --depth 1 https://github.com/ggerganov/whisper.cpp /opt/whisper.cpp \
 && cd /opt/whisper.cpp && make -j"$(nproc)" || true \
 && if [ -f /opt/whisper.cpp/main/whisper ]; then cp /opt/whisper.cpp/main/whisper /usr/local/bin/whisper_cpp || true; fi

# Configurar permisos finales
RUN chmod 0644 /etc/cron.d/mediajelly* \
    && chmod +x /mediajelly/scripts/*.py \
    && chmod +x /mediajelly/scripts/*.sh \
    && chmod +x /usr/local/bin/docker-entrypoint-hybrid.sh \
    && chmod 777 /mediajelly/scripts/logs /mediajelly/scripts/tmp

# Variables de entorno por defecto
ENV MEDIAJELLY_MODE=python
ENV PYTHONUNBUFFERED=1

# Punto de entrada híbrido
ENTRYPOINT ["/usr/local/bin/docker-entrypoint-hybrid.sh"]
