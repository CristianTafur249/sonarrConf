# Dockerfile para el servicio de cron de MediaJelly
FROM ubuntu:22.04

# Instala las dependencias necesarias
RUN apt-get update && apt-get install -y \
    cron \
    curl \
    ffmpeg \
    bash \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Configura la zona horaria
ENV TZ=America/Bogota
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Crea un usuario con UID/GID específicos para compatibilidad con el host
RUN groupadd -g 1000 mediauser && \
    useradd -u 1000 -g 1000 -m -s /bin/bash mediauser

# Crea el directorio de trabajo
WORKDIR /mediajelly

# Crea el directorio para logs y tmp
RUN mkdir -p /mediajelly/.scripts/logs /mediajelly/.scripts/tmp

# Crea el crontab para el usuario
RUN echo "# MediaJelly Cron Jobs" > /etc/cron.d/mediajelly && \
    echo "0 */12 * * * mediauser cd /mediajelly && /mediajelly/.scripts/cron-runner.sh >> /mediajelly/.scripts/logs/cron.log 2>&1" >> /etc/cron.d/mediajelly && \
    chmod 0644 /etc/cron.d/mediajelly && \
    crontab -u mediauser /etc/cron.d/mediajelly

# Script de inicio que ejecuta cron en primer plano
COPY docker-entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Da los permisos al usuario para el directorio de trabajo
RUN chown -R mediauser:mediauser /mediajelly

CMD ["/entrypoint.sh"]