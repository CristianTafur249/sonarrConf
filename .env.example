# MediaJelly - Environment Configuration Example
# Copy this file to .env and adjust values as needed
# cp .env.example .env

# ============================================================================
# SYSTEM CONFIGURATION
# ============================================================================

# User and Group IDs (run 'id' command to get yours)
PUID=1000
PGID=1000

# Timezone
TZ=America/Bogota

# ============================================================================
# MEDIAJELLY CONFIGURATION
# ============================================================================

# Execution mode: python (uses Python cron runner) or bash (legacy)
MEDIAJELLY_MODE=python

# Python optimization
PYTHONUNBUFFERED=1
PYTHONOPTIMIZE=2

# OpenMP threads for parallel processing
OMP_NUM_THREADS=4

# ============================================================================
# RESOURCE LIMITS
# ============================================================================

# Maximum memory usage in GB
MAX_MEMORY_GB=4

# Maximum concurrent compression processes
MAX_CONCURRENT_COMPRESSIONS=1

# FFmpeg timeout in seconds (2 hours default)
FFMPEG_TIMEOUT=7200

# ============================================================================
# TELEGRAM NOTIFICATIONS (Optional)
# ============================================================================
# Get bot token from @BotFather: https://t.me/BotFather
# Get chat ID from @userinfobot: https://t.me/userinfobot

# TELEGRAM_BOT_TOKEN=your_bot_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here
# NOTIFY_ON_SUCCESS=true
# NOTIFY_ON_ERROR=true

# ============================================================================
# TRANSMISSION-TELEGRAM BOT (opcional, servicio independiente)
# ============================================================================
# Token del bot para el control de Transmission (vía BotFather)
# TELEGRAM_TRANSMISSION_BOT=your_transmission_bot_token_here
# Usuario "master" autorizado para controlar Transmission (sin @)
# TELEGRAM_MASTER_USERNAME=your_telegram_username
# URL RPC de Transmission accesible desde la red Docker
# TRANSMISSION_URL=http://transmission:9091/transmission/rpc
# Credenciales RPC si aplica
# TRANSMISSION_USERNAME=
# TRANSMISSION_PASSWORD=

# ============================================================================
# WHISPER LANGUAGE DETECTION
# ============================================================================

# Whisper model size: tiny, base, small, medium, large
# Recommendation: base (good balance between speed and accuracy)
WHISPER_MODEL=base

# Enable language detection cache
LANGUAGE_CACHE_ENABLED=true

# ============================================================================
# SUBTITLE PROCESSING
# ============================================================================

# Process subtitles only during night hours (00:00-05:59)
SUBTITLE_NIGHT_ONLY=true
SUBTITLE_NIGHT_START=0
SUBTITLE_NIGHT_END=6

# ============================================================================
# COMPRESSION SETTINGS
# ============================================================================

# CRF (Constant Rate Factor) for video compression
# Lower = better quality, larger file. Range: 18-28. Default: 23
VIDEO_CRF=23

# Compression presets: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow
VIDEO_PRESET=medium

# ============================================================================
# PATHS (Usually don't need to change these)
# ============================================================================

# Media paths inside container
MEDIA_ANIME=/mediajelly/media/anime
MEDIA_MOVIES=/mediajelly/media/Peliculas
MEDIA_SERIES=/mediajelly/media/series

# Downloads path
DOWNLOADS_PATH=/mediajelly/downloads

# Scripts path
SCRIPTS_PATH=/mediajelly/scripts

# ============================================================================
# LOGGING
# ============================================================================

# Log retention in days
LOG_RETENTION_DAYS=7

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

