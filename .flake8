[flake8]
# Max line length
max-line-length = 120

# Ignore specific errors
ignore = 
    E203,  # whitespace before ':'
    E266,  # too many leading '#' for block comment
    E501,  # line too long (handled by black)
    W503,  # line break before binary operator
    F401,  # imported but unused (sometimes needed for re-exports)

# Exclude directories
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    ENV,
    env,
    build,
    dist,
    .eggs,
    *.egg-info,
    .pytest_cache,
    .mypy_cache,
    tests/fixtures,
    config/

# Per-file ignores
per-file-ignores =
    __init__.py:F401

# Show source code for each error
show-source = True

# Count errors
count = True

# Complexity
max-complexity = 15
